{
  "name": "fixoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names next,socket,worker \"next dev\" \"node server/socket-server.js\" \"node server/request-expiry-worker.js\"",
    "dev:turbo": "concurrently --kill-others --names next,socket,worker \"next dev --turbo\" \"node server/socket-server.js\" \"node server/request-expiry-worker.js\"",
    "build": "prisma generate && next build && node scripts/prepare-standalone-assets.js",
    "start": "node .next/standalone/server.js",
    "start:web": "node .next/standalone/server.js",
    "start:socket": "node server/socket-server.js",
    "start:worker": "node server/request-expiry-worker.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-db-flow.ts",
    "socket:dev": "node server/socket-server.js",
    "worker:expiry": "node server/request-expiry-worker.js",
    "worker:expiry:verify": "tsx scripts/verify-expiry-worker.ts",
    "verify:completion-idempotency": "tsx scripts/verify-completion-idempotency.ts",
    "verify:financial-reporting": "tsx scripts/verify-financial-reporting.ts",
    "audit:financial-state": "tsx scripts/audit-financial-state.ts",
    "db:reconcile-completion-metrics": "tsx scripts/reconcile-partner-completion-metrics.ts",
    "verify:partner-approval": "tsx scripts/verify-partner-approval.ts",
    "verify:partner-socket-approval": "tsx scripts/verify-partner-socket-approval.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.6",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "next": "^15.5.19",
    "razorpay": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.3"
  }
}
