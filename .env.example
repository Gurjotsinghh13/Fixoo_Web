# ==================================================
# Fixoo Backend Environment Variables
# ==================================================
# Do not commit real secrets. Use Railway variables in production.

# ==================================================
# Database
# ==================================================
# Runtime URL used by Next.js API routes, Socket.IO, workers, and scripts.
# Supabase production recommendation: Transaction Pooler URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=3&pool_timeout=5&connect_timeout=5"

# Direct database URL used by Prisma migrations/schema operations.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Optional DB health timeout in ms.
DATABASE_HEALTH_TIMEOUT_MS="5000"
ENABLE_STARTUP_DB_CHECK="false"

# Optional workaround for Supabase advisory-lock timeouts during migrate deploy.
# Set to "1" only if `prisma migrate deploy` reaches the DB but times out on pg_advisory_lock.
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=""

# ==================================================
# Authentication / JWT
# ==================================================
JWT_SECRET="replace-with-a-32-byte-or-longer-random-secret"
FIXOO_TENANT_ID="default"

# ==================================================
# Application URLs
# ==================================================
# Railway web service URL after deployment.
NEXT_PUBLIC_APP_URL="https://your-fixoo-web-service.up.railway.app"

# Comma-separated hostnames allowed for Server Actions, if different from NEXT_PUBLIC_APP_URL.
# Example: your-domain.com,admin.your-domain.com
APP_ALLOWED_ORIGINS=""

# ==================================================
# Socket.IO
# ==================================================
# Public Socket.IO service URL used by web/mobile clients.
NEXT_PUBLIC_SOCKET_URL="https://your-fixoo-socket-service.up.railway.app"

# Internal URL used by Next.js API routes and worker to POST /emit to the Socket.IO service.
SOCKET_INTERNAL_URL="https://your-fixoo-socket-service.up.railway.app"

# Strong shared secret for internal /emit endpoint.
SOCKET_INTERNAL_SECRET="replace-with-a-32-byte-or-longer-random-secret"

# Optional. The socket service automatically uses Railway's PORT when SOCKET_PORT is empty.
# Leave empty in Railway, or set to 3001 locally.
SOCKET_PORT="3001"

# Required when /emit is called across Railway services instead of same-host loopback.
SOCKET_ALLOW_REMOTE_EMIT="true"

# Optional: disable socket emits in verification scripts only.
DISABLE_SOCKET_EMIT="false"

# ==================================================
# OTP / MSG91
# ==================================================
# OTP delivery provider. Use "mock" only for development/test deployments. Use "msg91" for production SMS delivery.
OTP_PROVIDER="msg91"

# Legacy local-only shortcut. Prefer OTP_PROVIDER="mock" for Railway test deployments.
ENABLE_DEV_OTP="false"

# Required only when OTP_PROVIDER="msg91".
MSG91_API_KEY=""
MSG91_TEMPLATE_ID=""

# ==================================================
# Google Maps
# ==================================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ==================================================
# Razorpay
# ==================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ==================================================
# Support
# ==================================================
SUPPORT_PHONE=""
SUPPORT_WHATSAPP=""

# ==================================================
# Expiry Worker
# ==================================================
EXPIRY_WORKER_BATCH_SIZE="100"
EXPIRY_WORKER_MAX_BATCHES="10"

# ==================================================
# Misc
# ==================================================
NODE_ENV="production"



