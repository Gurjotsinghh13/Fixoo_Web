# Local PostgreSQL
DATABASE_URL="postgresql://fixoo:fixoo_password@localhost:5432/fixoo"
DIRECT_URL="postgresql://fixoo:fixoo_password@localhost:5432/fixoo"

# Supabase recommendation:
# DATABASE_URL should be the Transaction Pooler URL for runtime/serverless.
# DIRECT_URL should be the direct database URL for Prisma db push/migrations.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Auth
JWT_SECRET="replace-with-a-32-byte-or-longer-random-secret"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_INTERNAL_URL="http://localhost:3001"
SOCKET_INTERNAL_SECRET="replace-with-a-long-random-internal-secret"
SOCKET_PORT="3001"
ENABLE_DEV_OTP="false"

# Optional integrations
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
MSG91_API_KEY=""
MSG91_TEMPLATE_ID=""
SUPPORT_PHONE="9000000000"
SUPPORT_WHATSAPP="9000000000"
